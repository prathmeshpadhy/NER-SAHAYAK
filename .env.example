# =============================================================================
# NER-SAHAYAK — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# =============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=4000

# JSON Web Token Secret (Change in production!)
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars

# CORS Allowed Origins (Comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Weather Services Configuration
# OpenWeatherMap API Key (Optional - falls back to Open-Meteo & local deterministic models)
OPENWEATHER_API_KEY=

# Supabase PostgreSQL Configuration (Optional - falls back to local SQLite)
# Service Role Key has administrative access; NEVER expose to client/frontend
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional Generative AI Integration (Ask Sahayak)
# Keyless local rule-based intelligence is always active as a resilient fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Web Push Notification VAPID Keys (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ner-sahayak.in
