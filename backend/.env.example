# =============================================================================
# NER-SAHAYAK — Backend Environment Configuration
# =============================================================================

NODE_ENV=development
PORT=4000
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Weather Services
OPENWEATHER_API_KEY=

# Supabase PostgreSQL (Optional)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# AI Integration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Web Push VAPID Keys (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ner-sahayak.in
