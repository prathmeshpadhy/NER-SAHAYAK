# =============================================================================
# NER-Sahayak Backend Environment Configuration
# =============================================================================

PORT=4000
JWT_SECRET=ner-sahayak-jwt-super-secret-key-2026

# Supabase PostgreSQL Configuration (Backend Service Role)
# IMPORTANT: Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend / React application.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Supabase Anon Key (for public client reads if needed)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Optional AI / OpenAI integration for Ask Sahayak
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
